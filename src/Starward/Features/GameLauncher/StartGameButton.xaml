<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Starward.Features.GameLauncher.StartGameButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.GameLauncher"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:muxca="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary Source="GameButtonStyle.xaml" />
    </UserControl.Resources>

    <Grid x:Name="Grid_Root"
          Height="44"
          MinWidth="180"
          Background="{ThemeResource CustomAcrylicBrush}"
          CornerRadius="22"
          PointerEntered="Control_PointerEntered"
          PointerExited="Control_PointerExited"
          Shadow="{ThemeResource ThemeShadow}"
          Translation="0,0,16">

        <!--  Accent Color 背景  -->
        <Rectangle x:Name="Rect_AccentBackground"
                   Fill="{ThemeResource AccentFillColorDefaultBrush}"
                   IsHitTestVisible="False"
                   Visibility="{x:Bind IsAccentColorBackgroundVisible}" />

        <!--  主要按键  -->
        <Button x:Name="Button_GameAction"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                AutomationProperties.Name="{x:Bind GameActionAccessibilityText}"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind GameCommand}"
                CornerRadius="22"
                Foreground="{x:Bind ActionButtonForeground}"
                IsEnabledChanged="Button_GameAction_IsEnabledChanged"
                PointerEntered="Control_PointerEntered"
                PointerExited="Control_PointerExited"
                Style="{ThemeResource GameButtonStyle}">
            <Grid>
                <!--  非安装状态  -->
                <Grid Visibility="{x:Bind GameStateIsInstalling, Converter={StaticResource BoolToVisibilityReversedConverter}}">
                    <!--  转圈圈  -->
                    <ProgressRing Width="20"
                                  Height="20"
                                  Margin="14,0,0,0"
                                  HorizontalAlignment="Left"
                                  IsHitTestVisible="False"
                                  Visibility="{x:Bind IsGameActionCommandRunning}" />
                    <!--  按键文本： 开始游戏 / 游戏正在运行 / 安装游戏 / 更新游戏 / 更新插件 / 继续下载  -->
                    <TextBlock x:Name="TextBlock_StartGame"
                               Margin="41,5,53,6"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="{x:Bind StartGameButtonText}" />
                </Grid>

                <!--  安装中信息  -->
                <Grid Margin="0,0,48,0"
                      ColumnSpacing="10"
                      IsHitTestVisible="False"
                      Visibility="{x:Bind GameStateIsInstalling}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <!--  进度圈  -->
                    <Grid Margin="10,0,0,0" HorizontalAlignment="Left">
                        <ProgressRing Width="28"
                                      Height="28"
                                      Background="{ThemeResource ControlOnImageFillColorDefaultBrush}"
                                      IsIndeterminate="{x:Bind InstallProgressIsIndeterminate}"
                                      Value="{x:Bind ProgressRingValue}" />
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind ProgressRingText}" />
                    </Grid>


                    <!--  当前阶段信息  -->
                    <StackPanel x:Name="StackPanel_GameAction_InstallInfo"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Opacity="{x:Bind InstallInfoOpacity}"
                                Spacing="2">
                        <!--  当前阶段（仅文字）  -->
                        <TextBlock FontSize="{x:Bind InstallPhaseFontSize}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind InstallPhaseText}"
                                   TextAlignment="{x:Bind InstallPhaseTextAlignment}" />
                        <!--  剩余时间 / 网络或存储数据量  -->
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind InstallSecondaryText}"
                                   Visibility="{x:Bind InstallSecondaryText, Converter={StaticResource ObjectToVisibilityConverter}}" />
                    </StackPanel>


                    <!--  暂停 / 继续 / 重试  -->
                    <TextBlock x:Name="TextBlock_GameAction_PointerOver"
                               Grid.Column="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsTextScaleFactorEnabled="False"
                               Opacity="{x:Bind InstallActionTextOpacity}"
                               Text="{x:Bind InstallActionText}" />


                </Grid>

            </Grid>
        </Button>


        <!--  游戏设置  -->
        <Button x:Name="Button_Setting"
                Width="44"
                Height="44"
                Padding="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind SettingCommand}"
                CornerRadius="22"
                Foreground="{x:Bind SettingButtonForeground}"
                PointerEntered="Control_PointerEntered"
                PointerExited="Control_PointerExited"
                Style="{ThemeResource GameButtonStyle}"
                Visibility="Visible">
            <AnimatedIcon x:Name="AnimatedIcon_Setting">
                <AnimatedIcon.Source>
                    <muxca:AnimatedSettingsVisualSource />
                </AnimatedIcon.Source>
                <AnimatedIcon.FallbackIconSource>
                    <FontIconSource Glyph="&#xE713;" />
                </AnimatedIcon.FallbackIconSource>
            </AnimatedIcon>
        </Button>



        <!--  游戏进程信息 / 下载进度  -->
        <Popup x:Name="Popup_GameInfoOrDownloadProgress"
               DesiredPlacement="Top"
               PlacementTarget="{x:Bind Grid_Root}"
               VerticalOffset="-4">
            <Grid MinWidth="200"
                  MaxWidth="260"
                  Padding="16,12,16,12"
                  Background="{ThemeResource ControlOnImageFillColorDefaultBrush}"
                  CornerRadius="8">
                <!--  游戏进程信息  -->
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind RunningGameProcessInfo}"
                           Visibility="{x:Bind GameStateIsInstalling, Converter={StaticResource BoolToVisibilityReversedConverter}}" />

                <StackPanel MinWidth="200" Visibility="{x:Bind GameStateIsInstalling, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!--  操作 / 进度 / 步骤与状态 / 剩余时间  -->
                    <Grid ColumnSpacing="8" RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!--  当前操作  -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind InstallOperationText}"
                                   TextTrimming="CharacterEllipsis" />
                        <!--  进度百分比  -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind ProgressPercentText}"
                                   Visibility="{x:Bind ProgressPercentText, Converter={StaticResource ObjectToVisibilityConverter}}" />
                        <!--  第几步 · 当前状态  -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind InstallStepPhaseText}"
                                   TextTrimming="CharacterEllipsis" />
                        <!--  剩余时间  -->
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind RemainTimeText, Converter={StaticResource ObjectToVisibilityConverter}}">
                            <FontIcon VerticalAlignment="Center"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Glyph="&#xE917;"
                                      IsTextScaleFactorEnabled="False" />
                            <TextBlock FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       IsTextScaleFactorEnabled="False"
                                       Text="{x:Bind RemainTimeText}" />
                        </StackPanel>
                    </Grid>

                    <MenuFlyoutSeparator Margin="0,8,0,0" />

                    <!--  下载进度  -->
                    <StackPanel Margin="0,8,0,0"
                                Orientation="Horizontal"
                                Spacing="4"
                                Visibility="{x:Bind DownloadBytesText, Converter={StaticResource ObjectToVisibilityConverter}}">
                        <FontIcon FontSize="12"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Glyph="&#xE945;"
                                  IsTextScaleFactorEnabled="False" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind lang:Lang.SettingPage_Download}" />
                    </StackPanel>
                    <Grid Margin="16,2,0,0"
                          ColumnSpacing="6"
                          Visibility="{x:Bind DownloadBytesText, Converter={StaticResource ObjectToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind DownloadBytesText}" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind DownloadSpeedText}"
                                   Visibility="{x:Bind DownloadSpeedText, Converter={StaticResource ObjectToVisibilityConverter}}" />
                    </Grid>

                    <!--  安装 / 校验进度  -->
                    <Grid Margin="0,8,0,0"
                          ColumnSpacing="6"
                          Visibility="{x:Bind InstallBytesText, Converter={StaticResource ObjectToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  FontSize="12"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Glyph="&#xE8B7;"
                                  IsTextScaleFactorEnabled="False" />
                        <TextBlock Grid.Column="1"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind InstallBytesLabel}" />
                        <TextBlock Grid.Column="2"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind InstallBytesText}" />
                    </Grid>

                    <!--  硬链接  -->
                    <Grid Margin="0,8,0,0"
                          ColumnSpacing="6"
                          Visibility="{x:Bind HardLinkBytesText, Converter={StaticResource ObjectToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  FontSize="12"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Glyph="&#xE71B;"
                                  IsTextScaleFactorEnabled="False" />
                        <TextBlock Grid.Column="1"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind lang:Lang.LauncherPage_HardLink}" />
                        <TextBlock Grid.Column="2"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind HardLinkBytesText}" />
                    </Grid>

                    <!--  错误信息  -->
                    <TextBlock Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               IsTextScaleFactorEnabled="False"
                               MaxLines="3"
                               Text="{x:Bind ErrorMessage}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ErrorMessage, Converter={StaticResource ObjectToVisibilityConverter}}" />

                </StackPanel>
            </Grid>

        </Popup>


    </Grid>

</UserControl>
