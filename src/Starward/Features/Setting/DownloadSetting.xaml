<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="Starward.Features.Setting.DownloadSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.Setting"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Starward.Features"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel>

            <!--  下载限速  -->
            <TextBlock FontSize="20" Text="{x:Bind lang:Lang.DownloadSettingPage_SpeedLimit}" />
            <TextBlock Margin="0,12,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.DownloadSettingPage_TheNumber0MeansNoSpeedLimit}"
                       TextWrapping="Wrap" />
            <StackPanel Margin="0,12,0,0"
                        Orientation="Horizontal"
                        Spacing="12">
                <NumberBox MinWidth="120"
                           Minimum="0"
                           Value="{x:Bind SpeedLimit, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Text="KB/s" />
            </StackPanel>

            <Button Margin="0,12,0,0" Content="{x:Bind lang:Lang.Common_Confirm}" />


        </StackPanel>
    </ScrollViewer>

</sf:PageBase>
