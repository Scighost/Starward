<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowBase x:Class="Starward.Features.GameInstall.CutsceneResourceWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:local="using:Starward.Features.GameInstall"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:sf="using:Starward.Features"
               Title="CutsceneResourceWindow"
               x:DefaultBindMode="OneWay"
               mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          Loaded="RootGrid_Loaded"
          Unloaded="RootGrid_Unloaded">
        <WebView2 Name="webview" />
    </Grid>


</sf:WindowBase>
