<?xml version="1.0" encoding="utf-8" ?>
<sf:ContentDialogBase x:Class="Starward.Features.GameInstall.PreDownloadDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:lang="using:Starward.Language"
                      xmlns:local="using:Starward.Features.GameInstall"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:sf="using:Starward.Features"
                      xmlns:sh="using:Starward.Helpers"
                      x:DefaultBindMode="OneWay"
                      mc:Ignorable="d">


    <Grid Width="400" Padding="24">

        <StackPanel>


            <!--  预下载  -->
            <TextBlock FontSize="18"
                       FontWeight="Bold"
                       IsTextScaleFactorEnabled="False"
                       Text="{x:Bind lang:Lang.LauncherPage_PreInstall}" />

            <!--  获取资源中  -->
            <StackPanel x:Name="StackPanel_GettingResource"
                        Margin="2,12,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                <ProgressRing Width="16"
                              Height="16"
                              IsIndeterminate="True" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind lang:Lang.InstallGameDialog_LoadingDownloadResources}" />
            </StackPanel>


            <!--  版本  -->
            <StackPanel Margin="2,20,0,0"
                        Orientation="Horizontal"
                        Spacing="12"
                        Visibility="{x:Bind GameResourceLoaded}">
                <FontIcon FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE8EC;"
                          IsTextScaleFactorEnabled="False" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind PredownloadVersion}"
                           Visibility="{x:Bind PredownloadVersion, Converter={StaticResource ObjectToVisibilityConverter}}" />
            </StackPanel>


            <Border Margin="0,12,0,0"
                    Padding="12,8,12,8"
                    Background="{ThemeResource DateTimePickerFlyoutButtonBackgroundPointerOver}"
                    CornerRadius="8"
                    Visibility="{x:Bind GameResourceLoaded}">
                <StackPanel Spacing="8">
                    <!--  下载资源  -->
                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsTextScaleFactorEnabled="False"
                               Text="">
                        <Run Text="{x:Bind lang:Lang.InstallGameDialog_DownloadResources}" />
                        <Run Text="" />
                        <Run Text="{x:Bind DownloadResourceSizeText}" />
                    </TextBlock>
                    <!--  所需空间  -->
                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsTextScaleFactorEnabled="False"
                               Text="">
                        <Run Text="{x:Bind lang:Lang.InstallGameDialog_SpaceRequired}" />
                        <Run Text="" />
                        <Run Text="{x:Bind SpaceRequiredSizeText}" />
                    </TextBlock>
                    <!--  可用空间  -->
                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsTextScaleFactorEnabled="False"
                               Text="">
                        <Run Text="{x:Bind lang:Lang.InstallGameDialog_SpaceAvailable}" />
                        <Run Text="" />
                        <Run Text="{x:Bind SpaceAvailableSizeText}" />
                    </TextBlock>
                </StackPanel>
            </Border>



            <!--  错误信息  -->
            <TextBlock Margin="2,12,2,0"
                       FontSize="12"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       IsTextScaleFactorEnabled="False"
                       Text="{x:Bind ErrorMessage}"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind ErrorMessage, Converter={StaticResource ObjectToVisibilityConverter}}" />



            <!--  Start Predownload  -->
            <Button x:Name="Button_StartPredownload"
                    Grid.Column="2"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Command="{x:Bind StartPredownloadCommand}"
                    Content="{x:Bind lang:Lang.PreDownloadDialog_StartPreInstall}"
                    FontSize="14"
                    IsEnabled="False"
                    IsTextScaleFactorEnabled="False"
                    Style="{ThemeResource AccentButtonStyle}" />



        </StackPanel>



        <!--  Close Button  -->
        <Button Width="32"
                Height="32"
                Margin="-20"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                BorderThickness="0"
                Command="{x:Bind CloseCommand}"
                CornerRadius="8"
                Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
            <FontIcon FontSize="16"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Glyph="&#xE711;"
                      IsTextScaleFactorEnabled="False" />
        </Button>







    </Grid>


</sf:ContentDialogBase>
