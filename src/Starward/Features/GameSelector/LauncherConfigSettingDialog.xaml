<?xml version="1.0" encoding="utf-8" ?>
<sf:ContentDialogBase x:Class="Starward.Features.GameSelector.LauncherConfigSettingDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:lang="using:Starward.Language"
                      xmlns:local="using:Starward.Features.GameSelector"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:sc="using:Starward.Controls"
                      xmlns:scv="using:Starward.Converters"
                      xmlns:sf="using:Starward.Features"
                      x:DefaultBindMode="OneWay"
                      mc:Ignorable="d">

    <ContentDialog.Resources>
        <scv:EnumToIntConverter x:Key="EnumToIntConverter" />
    </ContentDialog.Resources>

    <Grid Width="802" Height="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition />
        </Grid.RowDefinitions>


        <Pivot x:Name="Pivot_Content"
               Grid.Row="1"
               Margin="0,-42,0,0">
            <Pivot.Resources>
                <Style BasedOn="{StaticResource DefaultPivotHeaderItemStyle}" TargetType="PivotHeaderItem">
                    <Setter Property="Height" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Style>
                <Style BasedOn="{StaticResource DefaultPivotItemStyle}" TargetType="PivotItem">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </Pivot.Resources>

            <!--  展示  -->
            <PivotItem Header="{x:Null}">
                <GridView Grid.Row="1"
                          Padding="24,12,24,12"
                          ItemsSource="{x:Bind LauncherConfigs}"
                          SelectionMode="None">
                    <GridView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                            <Setter Property="Padding" Value="2" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:LauncherConfigModel">
                            <Grid Width="180"
                                  Height="108"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                  BorderThickness="1"
                                  CornerRadius="8">
                                <Button x:Name="Button_EditConfig"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Click="Button_EditConfig_Click"
                                        Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
                                        Visibility="{x:Bind Editable}">
                                    <FontIcon Margin="0,0,-2,4"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Bottom"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Glyph="&#xE76C;"
                                              IsTextScaleFactorEnabled="False" />
                                </Button>
                                <StackPanel Margin="12"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind IsAddButton, Converter={StaticResource BoolToVisibilityReversedConverter}}">
                                    <sc:CachedImage Width="32"
                                                    Height="32"
                                                    Margin="2,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    CornerRadius="8"
                                                    Source="{x:Bind Icon}" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="16"
                                               IsTextScaleFactorEnabled="False"
                                               Text="{x:Bind Name}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsTextScaleFactorEnabled="False"
                                               Text="{x:Bind FeatureText}" />
                                </StackPanel>
                                <ToggleSwitch Margin="0,0,-104,0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Top"
                                              IsOn="{x:Bind IsSelected, Mode=TwoWay}"
                                              OffContent=""
                                              OnContent=""
                                              Visibility="{x:Bind IsAddButton, Converter={StaticResource BoolToVisibilityReversedConverter}}" />
                                <Button x:Name="Button_AddConfig"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        BorderThickness="0"
                                        Click="Button_AddConfig_Click"
                                        Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
                                        Visibility="{x:Bind IsAddButton}">
                                    <StackPanel Spacing="8">
                                        <FontIcon Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE710;" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   IsTextScaleFactorEnabled="False"
                                                   Text="{x:Bind lang:Lang.LauncherConfigSettingDialog_AddCustomChannel}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </PivotItem>

            <!--  编辑  -->
            <PivotItem Header="{x:Null}">
                <Grid Padding="24" ColumnSpacing="24">
                    <StackPanel Spacing="24">

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <!--  name  -->
                            <TextBlock Width="60"
                                       VerticalAlignment="Center"
                                       IsTextScaleFactorEnabled="False"
                                       Text="Name" />
                            <TextBox Width="224"
                                     IsSpellCheckEnabled="False"
                                     IsTextScaleFactorEnabled="False"
                                     Text="{x:Bind EditingConfig.Name, Mode=TwoWay}" />

                            <!--  id  -->
                            <TextBlock Width="72"
                                       Margin="24,0,0,0"
                                       VerticalAlignment="Center"
                                       IsTextScaleFactorEnabled="False"
                                       Text="{x:Bind EditingConfig.IdLabel, Mode=OneWay}" />
                            <TextBox Width="276"
                                     IsSpellCheckEnabled="False"
                                     IsTextScaleFactorEnabled="False"
                                     Text="{x:Bind EditingConfig.Id, Mode=TwoWay}" />
                        </StackPanel>


                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <!--  retion  -->
                            <TextBlock Width="60"
                                       VerticalAlignment="Center"
                                       IsTextScaleFactorEnabled="False"
                                       Text="Region" />
                            <ComboBox Width="224" SelectedIndex="{x:Bind EditingConfig.Region, Converter={StaticResource EnumToIntConverter}, Mode=TwoWay}">
                                <ComboBoxItem Content="HoYoverse" />
                                <ComboBoxItem Content="miHoYo" />
                                <ComboBoxItem Content="Hypergryph" />
                            </ComboBox>
                            <!--  channel  -->
                            <TextBlock Width="72"
                                       Margin="24,0,0,0"
                                       VerticalAlignment="Center"
                                       IsTextScaleFactorEnabled="False"
                                       Text="Channel" />
                            <NumberBox Width="80"
                                       IsTextScaleFactorEnabled="False"
                                       Minimum="0"
                                       SpinButtonPlacementMode="Hidden"
                                       Value="{x:Bind EditingConfig.Channel, Mode=TwoWay}" />
                            <!--  sub channel  -->
                            <TextBlock Width="80"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsTextScaleFactorEnabled="False"
                                       Text="Sub Channel" />
                            <NumberBox Width="80"
                                       IsTextScaleFactorEnabled="False"
                                       Minimum="0"
                                       SpinButtonPlacementMode="Hidden"
                                       Value="{x:Bind EditingConfig.SubChannel, Mode=TwoWay}" />
                        </StackPanel>


                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <!--  icon  -->
                            <TextBlock Width="60"
                                       VerticalAlignment="Center"
                                       IsTextScaleFactorEnabled="False"
                                       Text="Icon" />
                            <StackPanel Width="224"
                                        Orientation="Horizontal"
                                        Spacing="12">
                                <Button Padding="6"
                                        Click="Button_PickIcon_Click"
                                        IsTextScaleFactorEnabled="False">
                                    <FontIcon FontSize="16"
                                              Glyph="&#xE8E5;"
                                              IsTextScaleFactorEnabled="False" />
                                </Button>
                                <Border Width="40"
                                        Height="40"
                                        Margin="12,0,0,0">
                                    <sc:CachedImage Width="40"
                                                    Height="40"
                                                    CornerRadius="8"
                                                    Source="{x:Bind EditingConfig.Icon, Mode=OneWay}" />
                                </Border>
                            </StackPanel>

                            <!--  small icon  -->
                            <TextBlock Width="72"
                                       Margin="24,0,0,0"
                                       VerticalAlignment="Center"
                                       IsTextScaleFactorEnabled="False"
                                       Text="Small Icon" />
                            <Button Padding="6"
                                    Click="Button_PickSmallIcon_Click"
                                    IsTextScaleFactorEnabled="False">
                                <FontIcon FontSize="16"
                                          Glyph="&#xE8E5;"
                                          IsTextScaleFactorEnabled="False" />
                            </Button>
                            <Border Width="40"
                                    Height="40"
                                    Margin="12,0,0,0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="8"
                                    Visibility="{x:Bind EditingConfig.SmallIcon, Converter={StaticResource ObjectToVisibilityConverter}}">
                                <sc:CachedImage Width="20"
                                                Height="20"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Source="{x:Bind EditingConfig.SmallIcon, Mode=OneWay}" />
                            </Border>
                        </StackPanel>


                        <StackPanel Orientation="Horizontal"
                                    Spacing="12"
                                    Visibility="{x:Bind EditingConfig.IsHoYoLauncher, Mode=OneWay}">
                            <CheckBox Content="{x:Bind lang:Lang.LauncherConfigSettingDialog_AuthLogin}"
                                      IsChecked="{x:Bind EditingConfig.CanLogin, Mode=TwoWay}"
                                      IsEnabled="{x:Bind EditingConfig.IsBeta, Converter={StaticResource BoolReversedConverter}}"
                                      IsTextScaleFactorEnabled="False" />
                            <CheckBox Content="{x:Bind lang:Lang.LauncherConfigSettingDialog_BetaServer}"
                                      IsChecked="{x:Bind EditingConfig.IsBeta, Mode=TwoWay}"
                                      IsTextScaleFactorEnabled="False" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <Button x:Name="Button_SaveConfig"
                                    Command="{x:Bind SaveEditConfigCommand}"
                                    IsTextScaleFactorEnabled="False">
                                <TextBlock Margin="6,2,6,2"
                                           IsTextScaleFactorEnabled="False"
                                           Text="{x:Bind lang:Lang.Common_Save}" />
                            </Button>
                            <Button x:Name="Button_DeleteConfig" Command="{x:Bind DeleteEditConfigCommand}">
                                <TextBlock Margin="6,2,6,2"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           IsTextScaleFactorEnabled="False"
                                           Text="{x:Bind lang:Lang.Common_Delete}" />
                            </Button>
                        </StackPanel>

                        <ProgressRing HorizontalAlignment="Left"
                                      IsActive="True"
                                      Visibility="{x:Bind SaveEditConfigCommand.IsRunning}" />
                        <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind ErrorText}"
                                   TextWrapping="Wrap" />

                    </StackPanel>

                </Grid>
            </PivotItem>

        </Pivot>



        <TextBlock Margin="28,12,0,0"
                   FontSize="20"
                   Text="{x:Bind lang:Lang.LauncherConfigSettingDialog_LauncherChannelSetting}"
                   Visibility="{x:Bind EditingConfig, Converter={StaticResource ObjectToVisibilityReversedConverter}}" />

        <StackPanel Margin="24,12,0,0"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind EditingConfig, Converter={StaticResource ObjectToVisibilityConverter}}">
            <Button Width="32"
                    Height="32"
                    Padding="0"
                    BorderThickness="0"
                    Command="{x:Bind CancelEditConfigCommand}"
                    CornerRadius="8"
                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                <FontIcon FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE76B;"
                          IsTextScaleFactorEnabled="False" />
            </Button>
            <TextBlock VerticalAlignment="Center"
                       FontSize="20"
                       IsTextScaleFactorEnabled="False"
                       Text="{x:Bind lang:Lang.LauncherConfigSettingDialog_AddCustomChannel}" />
        </StackPanel>



        <StackPanel Margin="0,8,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="4">
            <!--  Save Button  -->
            <Button Width="32"
                    Height="32"
                    Padding="0"
                    BorderThickness="0"
                    Command="{x:Bind SaveEnabledLauncherCommand}"
                    CornerRadius="8"
                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
                    Visibility="{x:Bind EditingConfig, Converter={StaticResource ObjectToVisibilityReversedConverter}}">
                <FontIcon FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE74E;"
                          IsTextScaleFactorEnabled="False" />
            </Button>
            <!--  Close Button  -->
            <Button Width="32"
                    Height="32"
                    Padding="0"
                    BorderThickness="0"
                    Command="{x:Bind CloseCommand}"
                    CornerRadius="8"
                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                <FontIcon FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE711;"
                          IsTextScaleFactorEnabled="False" />
            </Button>
        </StackPanel>


    </Grid>

</sf:ContentDialogBase>
