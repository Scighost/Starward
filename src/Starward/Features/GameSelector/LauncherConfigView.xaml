<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Starward.Features.GameSelector.LauncherConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cw="using:CommunityToolkit.WinUI"
             xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.GameSelector"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="using:Starward"
             xmlns:sc="using:Starward.Controls"
             xmlns:sch="using:Starward.Core.HoYoPlay"
             xmlns:sh="using:Starward.Helpers"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid Background="{ThemeResource CustomAcrylicBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>



        <!--  已安装游戏  -->
        <Grid x:Name="Grid_InstalledGames"
              Grid.Row="1"
              Margin="52,8,0,20"
              RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <StackPanel Margin="16,0,0,0"
                        Orientation="Horizontal"
                        Spacing="16"
                        Visibility="{x:Bind InstalledGames, Converter={StaticResource CollectionToVisibilityConverter}}">
                <TextBlock VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="Bold"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind lang:Lang.LauncherConfigView_InstalledGames}" />
                <Button Padding="8"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{x:Bind UpdateInstalledGamesCommand}"
                        Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                    <FontIcon FontSize="16"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Glyph="&#xE72C;"
                              IsTextScaleFactorEnabled="False" />
                </Button>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextScaleFactorEnabled="False"
                           Visibility="{x:Bind ActualStorageSizeText, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <Run Text="{x:Bind lang:Lang.LauncherConfigView_ActualStorageSpaceUsed}" />
                    <Run Text="{x:Bind ActualStorageSizeText}" />
                </TextBlock>
            </StackPanel>

            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind InstalledGames}"
                      SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="Padding" Value="16,3,16,3" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:InstalledGameModel">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Grid Width="40"
                                  Height="40"
                                  VerticalAlignment="Center"
                                  CornerRadius="8">
                                <!--  游戏图标  -->
                                <sc:CachedImage Width="40"
                                                Height="40"
                                                CornerRadius="8"
                                                Source="{x:Bind GameIcon, FallbackValue={x:Null}}" />
                                <!--  服务器图标  -->
                                <sc:CachedImage Width="20"
                                                Height="20"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Source="{x:Bind LauncherIcon, FallbackValue={x:Null}}" />
                            </Grid>
                            <StackPanel MinWidth="180" VerticalAlignment="Center">
                                <!--  游戏名  -->
                                <TextBlock VerticalAlignment="Center"
                                           IsTextScaleFactorEnabled="False"
                                           Text="{x:Bind GameName}" />
                                <!--  服务器名  -->
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           IsTextScaleFactorEnabled="False"
                                           Text="{x:Bind LauncherName}" />
                            </StackPanel>
                            <!--  大小  -->
                            <StackPanel Width="120" VerticalAlignment="Center">
                                <TextBlock Margin="4,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           IsTextScaleFactorEnabled="False"
                                           Text="{x:Bind SizeText}" />
                                <Grid HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      CornerRadius="4">
                                    <Button Padding="4,1,4,1"
                                            VerticalAlignment="Center"
                                            sh:PointerCursor.CursorShape="Hand"
                                            BorderThickness="0"
                                            FontSize="12"
                                            IsTextScaleFactorEnabled="False"
                                            Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
                                            Visibility="{x:Bind SharedSizeText, Converter={StaticResource ObjectToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontSize="14"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      Glyph="&#xE71B;"
                                                      IsTextScaleFactorEnabled="False" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       IsTextScaleFactorEnabled="False"
                                                       Text="{x:Bind SharedSizeText}" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout>
                                                <Grid RowSpacing="12">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock MaxWidth="300"
                                                               FontSize="12"
                                                               IsTextScaleFactorEnabled="False"
                                                               TextWrapping="Wrap">
                                                        <Run Text="{x:Bind lang:Lang.LauncherConfigView_ShareStorageSpaceWithOtherGamesThroughHardLinks}" />
                                                        <Run Text="{x:Bind SharedSizeText}" />
                                                    </TextBlock>
                                                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind SharedModels}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Spacing="8" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="local:InstalledGameHardLinkSharedModel">
                                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                                    <Grid Width="40"
                                                                          Height="40"
                                                                          VerticalAlignment="Center"
                                                                          CornerRadius="8">
                                                                        <!--  游戏图标  -->
                                                                        <sc:CachedImage Width="40"
                                                                                        Height="40"
                                                                                        CornerRadius="8"
                                                                                        Source="{x:Bind GameIcon, FallbackValue={x:Null}}" />
                                                                        <!--  服务器图标  -->
                                                                        <sc:CachedImage Width="20"
                                                                                        Height="20"
                                                                                        HorizontalAlignment="Right"
                                                                                        VerticalAlignment="Bottom"
                                                                                        Source="{x:Bind LauncherIcon, FallbackValue={x:Null}}" />
                                                                    </Grid>
                                                                    <StackPanel MinWidth="140" VerticalAlignment="Center">
                                                                        <!--  游戏名  -->
                                                                        <TextBlock VerticalAlignment="Center"
                                                                                   IsTextScaleFactorEnabled="False"
                                                                                   Text="{x:Bind GameName}" />
                                                                        <!--  服务器名  -->
                                                                        <TextBlock VerticalAlignment="Center"
                                                                                   FontSize="12"
                                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                   IsTextScaleFactorEnabled="False"
                                                                                   Text="{x:Bind LauncherName}" />
                                                                    </StackPanel>
                                                                    <TextBlock MinWidth="80"
                                                                               VerticalAlignment="Center"
                                                                               HorizontalTextAlignment="Right"
                                                                               IsTextScaleFactorEnabled="False"
                                                                               Text="{x:Bind SizeText}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <!--  文件夹  -->
                            <Button x:Name="Button_OpenGameFolder"
                                    Margin="16,0,-4,0"
                                    Padding="6"
                                    VerticalAlignment="Center"
                                    Click="Button_OpenGameFolder_Click"
                                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                                <StackPanel Margin="6,0,6,0"
                                            Orientation="Horizontal"
                                            Spacing="12">
                                    <FontIcon FontSize="16"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Glyph="&#xE838;"
                                              IsTextScaleFactorEnabled="False" />
                                    <TextBlock MaxWidth="600"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsTextScaleFactorEnabled="False"
                                               Text="{x:Bind InstallPath}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </Grid>


        <!--  背景和介绍  -->
        <Grid x:Name="Grid_Background"
              Grid.RowSpan="4"
              IsHitTestVisible="False"
              Opacity="0">
            <Grid.OpacityTransition>
                <ScalarTransition />
            </Grid.OpacityTransition>

            <!--  背景  -->
            <sc:CachedImage x:Name="CachedImage_Background" Source="{x:Bind SelectedGameInfo.Display.Background.Url, FallbackValue={x:Null}}" />
            <Image Source="ms-appx:///Assets/Image/LauncherMask.png" Stretch="UniformToFill" />

            <!--  logo  -->
            <Border x:Name="CachedImage_TopLeftLogo"
                    Width="200"
                    Margin="20,20,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Opacity="0"
                    Translation="0,20,0">
                <Border.OpacityTransition>
                    <ScalarTransition />
                </Border.OpacityTransition>
                <Border.TranslationTransition>
                    <Vector3Transition />
                </Border.TranslationTransition>
                <sc:CachedImage Source="{x:Bind SelectedGameInfo.Display.TopLeftLogo.Url, FallbackValue={x:Null}}" />
            </Border>

            <!--  介绍  -->
            <TextBlock x:Name="TextBlock_Introduction"
                       Margin="64,0,72,220"
                       VerticalAlignment="Bottom"
                       FontSize="16"
                       IsTextScaleFactorEnabled="False"
                       Opacity="0"
                       Text="{x:Bind SelectedGameInfo.Display.Introduction, FallbackValue={x:Null}}"
                       TextWrapping="Wrap"
                       Translation="0,20,0">
                <TextBlock.OpacityTransition>
                    <ScalarTransition />
                </TextBlock.OpacityTransition>
                <TextBlock.TranslationTransition>
                    <Vector3Transition />
                </TextBlock.TranslationTransition>
            </TextBlock>

        </Grid>


        <!--  游戏列表  -->
        <Grid Grid.Row="2" Visibility="{x:Bind GameInfos, Converter={StaticResource ObjectToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>
            <!--  收起按键  -->
            <Button Padding="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Command="{x:Bind CloseGameInfoGridCommand}"
                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                <FontIcon FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE70D;"
                          IsTextScaleFactorEnabled="False" />
            </Button>

            <Button x:Name="Button_ScrollLeft"
                    Grid.Column="1"
                    Height="120"
                    Margin="0,0,8,0"
                    Padding="2,0,2,0"
                    VerticalAlignment="Top"
                    BorderThickness="0"
                    Command="{x:Bind ScrollLeftCommand}"
                    CornerRadius="6"
                    Visibility="Collapsed">
                <FontIcon FontSize="16" Glyph="&#xE76B;" />
            </Button>

            <Button x:Name="Button_ScrollRight"
                    Grid.Column="3"
                    Height="120"
                    Margin="12,0,0,0"
                    Padding="2,0,2,0"
                    VerticalAlignment="Top"
                    BorderThickness="0"
                    Command="{x:Bind ScrollRightCommand}"
                    CornerRadius="6"
                    Visibility="Collapsed">
                <FontIcon FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE76C;" />
            </Button>

            <!--  列表  -->
            <GridView x:Name="GridView_GameInfos"
                      Grid.Column="2"
                      ItemsSource="{x:Bind GameInfos}"
                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      ScrollViewer.HorizontalScrollMode="Auto"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      SelectionMode="None">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Padding" Value="4,0,4,4" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:GameInfoModel" x:DefaultBindMode="OneWay">
                        <Grid x:Name="Grid_GameDisplay"
                              Width="120"
                              Height="120"
                              cw:UIElementExtensions.ClipToBounds="True"
                              CornerRadius="12"
                              PointerEntered="Grid_GameDisplay_PointerEntered"
                              PointerExited="Grid_GameDisplay_PointerExited"
                              Shadow="{ThemeResource ThemeShadow}"
                              Tapped="Grid_GameDisplay_Tapped"
                              Translation="0,0,16">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       IsTextScaleFactorEnabled="False"
                                       Text="{x:Bind GameInfo.Display.Name}" />
                            <!--  缩略图  -->
                            <sc:CachedImage Width="120"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="{x:Bind GameInfo.Display.Thumbnail.Url}"
                                            Stretch="UniformToFill" />
                            <!--  logo  -->
                            <sc:CachedImage x:Name="CachedImage_Logo"
                                            Width="120"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#40000000"
                                            Source="{x:Bind GameInfo.Display.Logo.Url}"
                                            Stretch="UniformToFill">
                                <sc:CachedImage.OpacityTransition>
                                    <ScalarTransition />
                                </sc:CachedImage.OpacityTransition>
                            </sc:CachedImage>
                            <!--  固定  -->
                            <Border x:Name="Border_Mask"
                                    Background="#B0000000"
                                    Opacity="0">
                                <Border.OpacityTransition>
                                    <ScalarTransition />
                                </Border.OpacityTransition>
                                <Button x:Name="Button_Pin"
                                        Padding="6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
                                        Tapped="Button_Pin_Tapped">
                                    <Grid>
                                        <FontIcon x:Name="FontIcon_Pin"
                                                  FontSize="16"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  Glyph="&#xE718;"
                                                  IsTextScaleFactorEnabled="False" />
                                        <FontIcon x:Name="FontIcon_PinFill"
                                                  FontSize="16"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  Glyph="&#xE841;"
                                                  IsTextScaleFactorEnabled="False"
                                                  Visibility="{x:Bind IsPinned}" />
                                    </Grid>
                                </Button>
                            </Border>
                            <!--  预约  -->
                            <Border Padding="6,4,6,4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource SystemFillColorCautionBrush}"
                                    CornerRadius="12,0,12,0"
                                    Visibility="{x:Bind EnableReservation}">
                                <TextBlock FontSize="12"
                                           Foreground="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                           IsTextScaleFactorEnabled="False"
                                           Text="{x:Bind lang:Lang.LauncherConfigView_PreRegister}" />
                            </Border>
                            <!--  图标  -->
                            <StackPanel x:Name="StackPanel_ViewDetails"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Opacity="0"
                                        Spacing="4"
                                        Translation="0,12,0">
                                <StackPanel.OpacityTransition>
                                    <ScalarTransition />
                                </StackPanel.OpacityTransition>
                                <StackPanel.TranslationTransition>
                                    <Vector3Transition />
                                </StackPanel.TranslationTransition>
                                <sc:CachedImage Width="40"
                                                Height="40"
                                                CornerRadius="8"
                                                Source="{x:Bind GameInfo.Display.Icon.Url}" />
                                <TextBlock HorizontalAlignment="Center"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           IsTextScaleFactorEnabled="False"
                                           Text="{x:Bind lang:Lang.LauncherConfigView_ViewDetails}" />
                            </StackPanel>
                            <!--  边框  -->
                            <Rectangle x:Name="Rectangle_BorderAnimation"
                                       IsHitTestVisible="False"
                                       Opacity="0"
                                       RadiusX="12"
                                       RadiusY="12"
                                       Stroke="{ThemeResource SystemFillColorCautionBrush}"
                                       StrokeDashOffset="-8"
                                       StrokeThickness="2">
                                <Rectangle.OpacityTransition>
                                    <ScalarTransition />
                                </Rectangle.OpacityTransition>
                            </Rectangle>
                            <Grid.Resources>
                                <Storyboard x:Name="ProgressStoryboard">
                                    <ObjectAnimationUsingKeyFrames EnableDependentAnimation="True"
                                                                   Storyboard.TargetName="Rectangle_BorderAnimation"
                                                                   Storyboard.TargetProperty="StrokeDashArray"
                                                                   Duration="0:0:0.3">
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.0000" Value="0.0 112.0" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.0086" Value="3.2 108.8" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.0171" Value="6.4 105.6" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.0257" Value="9.6 102.4" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.0343" Value="12.8 99.2" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.0429" Value="16.0 96.0" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.0514" Value="19.2 92.8" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.0600" Value="22.4 89.6" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.0686" Value="25.6 86.4" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.0771" Value="28.8 83.2" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.0857" Value="32.0 80.0" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.0943" Value="35.2 76.8" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.1029" Value="38.4 73.6" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.1114" Value="41.6 70.4" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.1200" Value="44.8 67.2" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.1286" Value="48.0 64.0" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.1371" Value="51.2 60.8" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.1457" Value="54.4 57.6" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.1543" Value="57.6 54.4" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.1629" Value="60.8 51.2" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.1714" Value="64.0 48.0" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.1800" Value="67.2 44.8" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.1886" Value="70.4 41.6" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.1971" Value="73.6 38.4" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.2057" Value="76.8 35.2" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.2143" Value="80.0 32.0" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.2229" Value="83.2 28.8" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.2314" Value="86.4 25.6" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.2400" Value="89.6 22.4" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.2486" Value="92.8 19.2" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.2571" Value="96.0 16.0" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.2657" Value="99.2 12.8" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.2743" Value="102.4 9.6" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.2829" Value="105.6 6.4" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.2914" Value="108.8 3.2" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.3000" Value="112.0 0.0" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </Grid.Resources>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

        </Grid>


        <!--  启动器列表  -->
        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Width="28"
                   Height="28"
                   Margin="20,0,0,12"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Source="ms-appx:///Assets/Image/icon_hoyoplay.png" />

            <ListView x:Name="ListView_LauncherConfig"
                      Grid.Column="1"
                      Margin="8,0,0,12"
                      VerticalAlignment="Center"
                      AllowDrop="True"
                      Background="Transparent"
                      BorderThickness="0"
                      CanReorderItems="{x:Bind s:AppConfig.IsAdmin, Converter={StaticResource BoolReversedConverter}}"
                      ItemsSource="{x:Bind LauncherConfigs}"
                      SelectionChanged="ListView_LauncherConfig_SelectionChanged">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:LauncherConfigModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <sc:CachedImage MaxWidth="24"
                                            MaxHeight="24"
                                            CornerRadius="4"
                                            Source="{x:Bind Icon}" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       IsTextScaleFactorEnabled="False"
                                       Text="{x:Bind Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  查找游戏  -->
            <Button x:Name="Button_FindGames"
                    Grid.Column="2"
                    Margin="12,0,0,12"
                    Padding="8"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Command="{x:Bind FindGamesCommand}">
                <FontIcon FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE721;"
                          IsTextScaleFactorEnabled="False" />
            </Button>

            <!--  启动器渠道  -->
            <Button x:Name="Button_ChannelServer"
                    Grid.Column="3"
                    Margin="12,0,0,12"
                    Padding="8"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Command="{x:Bind OpenLauncherConfigSettingDialogCommand}">
                <FontIcon FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE712;"
                          IsTextScaleFactorEnabled="False" />
            </Button>

            <!--  操作提醒  -->
            <TeachingTip x:Name="TeachingTip_FindGames"
                         Title="{x:Bind lang:Lang.LauncherConfigView_FindInstalledGamesOrAddChannelServers}"
                         CloseButtonClick="TeachingTip_FindGames_CloseButtonClick"
                         PlacementMargin="12"
                         PreferredPlacement="Right"
                         ShouldConstrainToRootBounds="True"
                         Target="{x:Bind Button_ChannelServer}" />

        </Grid>


        <!--  预约页面  -->
        <local:GameReservationView x:Name="ReservationView"
                                   Grid.RowSpan="4"
                                   x:Load="{x:Bind ReservationViewLoad}"
                                   IsHitTestVisible="False"
                                   Opacity="0"
                                   ReservationContent="{x:Bind ReservationContent}">
            <local:GameReservationView.OpacityTransition>
                <ScalarTransition />
            </local:GameReservationView.OpacityTransition>
        </local:GameReservationView>


        <!--  Back Button  -->
        <Button Width="40"
                Height="40"
                Margin="7,9,0,0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                sh:PointerCursor.CursorShape="Hand"
                BorderThickness="0"
                Command="{x:Bind GoBackCommand}"
                CornerRadius="8">
            <FontIcon FontSize="16"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Glyph="&#xE830;"
                      IsTextScaleFactorEnabled="False" />
        </Button>



    </Grid>
</UserControl>
