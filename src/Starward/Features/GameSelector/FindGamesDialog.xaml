<?xml version="1.0" encoding="utf-8" ?>
<sf:ContentDialogBase x:Class="Starward.Features.GameSelector.FindGamesDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:lang="using:Starward.Language"
                      xmlns:local="using:Starward.Features.GameSelector"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:sc="using:Starward.Controls"
                      xmlns:sf="using:Starward.Features"
                      x:DefaultBindMode="OneWay"
                      mc:Ignorable="d">

    <Grid Width="800" Height="540">

        <TextBlock Margin="24,12,0,0"
                   FontSize="20"
                   IsTextScaleFactorEnabled="False"
                   Text="{x:Bind lang:Lang.FindGamesDialog_FindInstalledGames}" />

        <Button Width="32"
                Height="32"
                Margin="8"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                BorderThickness="0"
                Command="{x:Bind CloseCommand}"
                CornerRadius="8"
                Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
            <FontIcon FontSize="16"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Glyph="&#xE711;"
                      IsTextScaleFactorEnabled="False" />
        </Button>



        <Grid x:Name="Grid_SelectFolder"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              ColumnSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Width="200"
                    Height="120"
                    HorizontalAlignment="Right"
                    Command="{x:Bind FindFromRegistryCommand}">
                <StackPanel Spacing="12">
                    <FontIcon Glyph="&#xE945;" IsTextScaleFactorEnabled="False" />
                    <TextBlock FontSize="16"
                               IsTextScaleFactorEnabled="False"
                               Text="{x:Bind lang:Lang.FindGamesDialog_QuickSearch}" />
                </StackPanel>
            </Button>

            <Button Grid.Column="1"
                    Width="200"
                    Height="120"
                    HorizontalAlignment="Right"
                    Command="{x:Bind FindFolderCommand}">
                <StackPanel Spacing="12">
                    <FontIcon Glyph="&#xE838;" IsTextScaleFactorEnabled="False" />
                    <TextBlock FontSize="16"
                               IsTextScaleFactorEnabled="False"
                               Text="{x:Bind lang:Lang.SelectDirectoryPage_SelectFolder}" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2"
                    Width="200"
                    Height="120"
                    HorizontalAlignment="Left"
                    Command="{x:Bind FindAllDriveCommand}">
                <StackPanel Spacing="12">
                    <FontIcon Glyph="&#xF246;" IsTextScaleFactorEnabled="False" />
                    <TextBlock FontSize="16"
                               IsTextScaleFactorEnabled="False"
                               Text="{x:Bind lang:Lang.FindGamesDialog_ScanAllDrives}" />
                </StackPanel>
            </Button>


            <TextBlock x:Name="TextBlock_NoGameResource"
                       Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Margin="24"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsTextScaleFactorEnabled="False"
                       Text="{x:Bind lang:Lang.FindGamesDialog_NoGameFilesWereFound}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />


        </Grid>


        <StackPanel x:Name="StackPanel_Searching"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
            <ProgressRing IsActive="True" />
        </StackPanel>

        <Grid x:Name="Search_Result"
              Margin="0,48,0,0"
              Visibility="{x:Bind FindGames, Converter={StaticResource ObjectToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView Padding="8,0,12,0"
                      ItemsSource="{x:Bind FindGames}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:FindGameModel">
                        <Grid Margin="0,4,0,4"
                              Padding="16,8,12,8"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                              BorderThickness="0"
                              CornerRadius="8">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsTextScaleFactorEnabled="False">
                                <StackPanel Margin="12,0,0,0" Orientation="Horizontal">

                                    <sc:CachedImage Width="36"
                                                    Height="36"
                                                    CornerRadius="8"
                                                    Source="{x:Bind GameInfo.Display.Icon.Url}" />
                                    <StackPanel MinWidth="140"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock IsTextScaleFactorEnabled="False" Text="{x:Bind GameInfo.Display.Name}" />
                                        <TextBlock FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   IsTextScaleFactorEnabled="False"
                                                   Text="{x:Bind LauncherConfig.Name}" />
                                    </StackPanel>
                                </StackPanel>
                            </CheckBox>


                            <RadioButtons Grid.Row="1"
                                          Margin="48,0,0,0"
                                          ItemsSource="{x:Bind Paths}"
                                          SelectedIndex="{x:Bind SelectIndex, Mode=TwoWay}">
                                <RadioButtons.Style>
                                    <Style TargetType="RadioButtons">
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Setter Property="TabNavigation" Value="Once" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButtons">
                                                    <StackPanel>
                                                        <ContentPresenter x:Name="HeaderContentPresenter"
                                                                          Margin="{ThemeResource RadioButtonsTopHeaderMargin}"
                                                                          Content="{TemplateBinding Header}"
                                                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                                          Foreground="{ThemeResource RadioButtonsHeaderForeground}" />
                                                        <ItemsRepeater x:Name="InnerRepeater">
                                                            <ItemsRepeater.Layout>
                                                                <ColumnMajorUniformToLargestGridLayout ColumnSpacing="{ThemeResource RadioButtonsColumnSpacing}"
                                                                                                       MaxColumns="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=MaxColumns}"
                                                                                                       RowSpacing="2" />
                                                            </ItemsRepeater.Layout>
                                                        </ItemsRepeater>
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal" />
                                                                <VisualState x:Name="Disabled">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="HeaderContentPresenter.Foreground" Value="{ThemeResource RadioButtonsHeaderForegroundDisabled}" />
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButtons.Style>
                                <RadioButtons.ItemTemplate>
                                    <DataTemplate x:DataType="local:FindGameModelPath">
                                        <StackPanel Margin="12,0,0,0"
                                                    VerticalAlignment="Stretch"
                                                    Orientation="Horizontal">
                                            <TextBlock Width="480"
                                                       VerticalAlignment="Center"
                                                       IsTextScaleFactorEnabled="False"
                                                       Text="{x:Bind InstallPath}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Width="40"
                                                       Margin="20,0,0,0"
                                                       VerticalAlignment="Center"
                                                       IsTextScaleFactorEnabled="False"
                                                       Text="{x:Bind Version}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Width="80"
                                                       VerticalAlignment="Center"
                                                       HorizontalTextAlignment="Right"
                                                       IsTextScaleFactorEnabled="False"
                                                       Text="{x:Bind SizeText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </RadioButtons.ItemTemplate>
                            </RadioButtons>

                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>


            <StackPanel Grid.Row="1"
                        Margin="24,12,24,12"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="24">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind lang:Lang.FindGamesDialog_SelectTheGamesToAdd}" />
                <Button Padding="16,8,16,8"
                        BorderThickness="0"
                        Command="{x:Bind AddGamesCommand}"
                        Content="{x:Bind lang:Lang.FindGamesDialog_AddGames}"
                        Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>

        </Grid>


    </Grid>

</sf:ContentDialogBase>
