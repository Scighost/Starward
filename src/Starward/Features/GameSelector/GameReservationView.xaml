<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Starward.Features.GameSelector.GameReservationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.GameSelector"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sc="using:Starward.Controls"
             xmlns:sch="using:Starward.Core.HoYoPlay"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary Source="/Features/GameSelector/ReservationMediaTransportControlsStyle.xaml" />
    </UserControl.Resources>

    <Grid>

        <!--  背景效果  -->
        <sc:CachedImage Grid.RowSpan="2"
                        Grid.ColumnSpan="3"
                        Source="{x:Bind SelectedMedia.Cover.Url}" />
        <Border Grid.RowSpan="2"
                Grid.ColumnSpan="3"
                Background="{ThemeResource CustomAcrylicBrush}" />


        <!--  大图  -->
        <Grid x:Name="Grid_Media"
              Width="720"
              Height="405"
              Margin="68,100,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              CornerRadius="20">
            <FlipView x:Name="FlipView_Media"
                      Background="Transparent"
                      ItemsSource="{x:Bind ReservationContent.Medias}"
                      Loaded="FlipView_Media_Loaded"
                      SelectedValue="{x:Bind SelectedMedia, Mode=TwoWay}">
                <FlipView.ItemTemplate>
                    <DataTemplate x:DataType="sch:GameReservationMedia">
                        <Grid>
                            <!--  图片  -->
                            <sc:CachedImage x:Name="CachedImage_MediaImage"
                                            Source="{x:Bind Cover.Url}"
                                            Stretch="UniformToFill" />
                            <!--  视频  -->
                            <MediaPlayerElement x:Name="MediaPlayer_Video"
                                                AreTransportControlsEnabled="True"
                                                Visibility="Collapsed">
                                <MediaPlayerElement.TransportControls>
                                    <MediaTransportControls IsSeekBarVisible="True"
                                                            IsVolumeButtonVisible="True"
                                                            IsVolumeEnabled="True"
                                                            Style="{StaticResource ReservationMediaTransportControlsStyle}" />
                                </MediaPlayerElement.TransportControls>
                            </MediaPlayerElement>
                        </Grid>
                    </DataTemplate>
                </FlipView.ItemTemplate>
            </FlipView>

        </Grid>


        <!--  图片预览  -->
        <Grid Grid.Row="1"
              Grid.Column="0"
              Width="720"
              Margin="68,0,0,36"
              HorizontalAlignment="Left"
              VerticalAlignment="Bottom"
              ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Height="63"
                    Padding="2,0,2,0"
                    VerticalAlignment="Top"
                    Command="{x:Bind ScrollLeftCommand}">
                <FontIcon FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE76B;" />
            </Button>

            <Button Grid.Column="2"
                    Height="63"
                    Padding="2,0,2,0"
                    VerticalAlignment="Top"
                    Command="{x:Bind ScrollRightCommand}">
                <FontIcon FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE76C;" />
            </Button>

            <GridView x:Name="GridView_ImageLines"
                      Grid.Column="1"
                      ItemsSource="{x:Bind ReservationContent.Medias}"
                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      ScrollViewer.HorizontalScrollMode="Auto"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      SelectedValue="{x:Bind SelectedMedia, Mode=TwoWay}">
                <GridView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                        <Setter Property="Margin" Value="8,0,8,0" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="sch:GameReservationMedia">
                        <Grid>
                            <sc:CachedImage Width="112"
                                            Height="63"
                                            Source="{x:Bind Cover.Url}"
                                            Stretch="UniformToFill" />
                            <Border Background="#60000000" />
                            <FontIcon HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Glyph="&#xEA0C;"
                                      IsTextScaleFactorEnabled="False"
                                      Visibility="{x:Bind local:GameReservationView.IsVideoMedia(Type)}" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>


        <!--  介绍  -->
        <StackPanel Margin="820,100,68,0" Spacing="16">
            <!--  logo  -->
            <sc:CachedImage Height="64"
                            HorizontalAlignment="Left"
                            Source="{x:Bind ReservationContent.Logo}" />
            <!--  介绍  -->
            <TextBlock FontSize="16"
                       IsTextScaleFactorEnabled="False"
                       Text="{x:Bind ReservationContent.Introduction}"
                       TextWrapping="Wrap" />
            <!--  标签  -->
            <ItemsRepeater ItemsSource="{x:Bind ReservationContent.Tags}">
                <ItemsRepeater.Layout>
                    <cwc:WrapLayout HorizontalSpacing="8" VerticalSpacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="sch:GameReservationTag">
                        <Border Padding="10,6,10,6"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                CornerRadius="8">
                            <TextBlock IsTextScaleFactorEnabled="False" Text="{x:Bind Name}" />
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>


        <!--  预约按键  -->
        <Button Height="56"
                MinWidth="240"
                Margin="840,0,0,50"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                BorderThickness="0"
                Command="{x:Bind OpenHomePageCommand}"
                CornerRadius="28"
                Style="{ThemeResource AccentButtonStyle}">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <FontIcon Margin="20,0,0,0"
                          FontWeight="Bold"
                          Glyph="&#xEA8F;" />
                <TextBlock Grid.Column="1"
                           Margin="0,0,20,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           Text="{x:Bind lang:Lang.GameReservationView_PreRegister}" />
            </Grid>
        </Button>


        <!--  媒体图标  -->
        <ItemsControl Width="48"
                      Margin="0,60,0,0"
                      HorizontalAlignment="Right"
                      ItemsSource="{x:Bind ReservationContent.Icons}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sch:GameReservationIcon">
                    <Button x:Name="Button_MediaIcon"
                            Width="40"
                            Height="40"
                            Padding="2"
                            HorizontalAlignment="Center"
                            Click="Button_MediaIcon_Click"
                            PointerEntered="Button_MediaIcon_PointerEntered"
                            PointerExited="Button_MediaIcon_PointerExited"
                            Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                        <!--  icon  -->
                        <sc:CachedImage Source="{x:Bind Icon.Url}" />
                        <!--  二维码  -->
                        <ToolTipService.ToolTip>
                            <ToolTip x:Name="ToolTip_QrImage"
                                     Padding="0"
                                     BorderThickness="0"
                                     CornerRadius="8"
                                     Placement="Left"
                                     Visibility="Collapsed">
                                <sc:CachedImage Width="160"
                                                Height="160"
                                                Source="{x:Bind QrImage.Url}" />
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>


    </Grid>

</UserControl>
